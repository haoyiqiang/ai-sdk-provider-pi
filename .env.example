# ─────────────────────────
# ai-sdk-provider-pi — 环境变量
# ─────────────────────────
#
# 复制为 .env 并根据需要修改
# cp .env.example .env
#

# 启用集成测试（需要真实 API key）
PI_INTEGRATION_TEST=true

# DeepSeek（用于 doGenerate / doStream / error-recovery 集成测试）
# Pi 使用 DEEPSEEK_API_KEY 自动配置 DeepSeek 模型
# 注册: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Anthropic（用于工具执行集成测试）
# 获取: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ─── 以下可选，用于多 provider 验证 ───
# OpenAI
# OPENAI_API_KEY=sk-...
# Google Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=...
