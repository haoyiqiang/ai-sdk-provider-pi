# ─────────────────────────
# ai-sdk-provider-pi — 环境变量
# ─────────────────────────
#
# 复制为 .env 并根据需要修改
# cp .env.example .env
#

# ─── Example 配置 ───
# 指定 examples/ 中使用的模型（默认：deepseek/deepseek-v4-flash）
# 支持完整格式（provider/model-id）和便捷别名：
#   deepseek-v4-flash, deepseek-v4-pro, deepseek-chat, deepseek-reasoner
#   sonnet, opus, haiku, gpt-4o, gpt-4o-mini, o3, o4-mini
#   gemini-2.5-pro, gemini-2.5-flash
PI_MODEL_ID=deepseek-v4-flash

# ─── 集成测试配置 ───
# 启用集成测试（需要真实 API key）
PI_INTEGRATION_TEST=true

# DeepSeek（用于所有集成测试和 examples）
# 注册: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
