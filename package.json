{
  "name": "ai-sdk-provider-pi",
  "version": "0.1.0",
  "description": "AI SDK v6 provider for Pi Coding Agent (supports 15+ LLM providers)",
  "keywords": [
    "ai-sdk",
    "pi-coding-agent",
    "llm",
    "language-model",
    "anthropic",
    "openai",
    "google",
    "mistral",
    "bedrock"
  ],
  "homepage": "https://github.com/earendil-works/ai-sdk-provider-pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/ai-sdk-provider-pi.git"
  },
  "bugs": {
    "url": "https://github.com/earendil-works/ai-sdk-provider-pi/issues"
  },
  "license": "MIT",
  "author": "Earendil Works",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "PI_INTEGRATION_TEST=true vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/provider-utils": "^4.0.1",
    "@earendil-works/pi-ai": "^0.79.1",
    "@earendil-works/pi-coding-agent": "^0.79.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "ai": "^6.0.3",
    "dotenv": "^17.4.2",
    "prettier": "^3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.6.3",
    "vitest": "3.2.4",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
